{
  "manifest_version": 3,
  "name": "YT Auto Miniplayer",
  "version": "0.1.0",
  "description": "Opens the YouTube miniplayer when you leave a watch page.",
  "icons": {
    "16": "icons/yt_auto_pip_16.png",
    "32": "icons/yt_auto_pip_32.png",
    "48": "icons/yt_auto_pip_48.png",
    "128": "icons/yt_auto_pip_128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "src/decide.js",
        "src/youtube-page.js",
        "src/settings.js",
        "src/watch-timer.js",
        "src/back.js",
        "src/content.js",
        "src/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Auto Miniplayer",
    "default_icon": {
      "16": "icons/yt_auto_pip_16.png",
      "32": "icons/yt_auto_pip_32.png",
      "48": "icons/yt_auto_pip_48.png",
      "128": "icons/yt_auto_pip_128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-auto-miniplayer@markkyaw",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
